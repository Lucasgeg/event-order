# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# claude code (skills téléchargées, config locale)
.claude/

# python
__pycache__/
*.pyc

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# .env.test contient uniquement des identifiants Postgres locaux fixes
# (docker-compose.yml) — pas de secret réel, on le commite pour que
# `bun run test:integration` marche sans setup manuel.
!.env.test

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

# config MCP locale (Claude Code)
.mcp.json
